# --- Rete Solana ---
# RPC endpoint. Usa un provider con supporto a "getSignaturesForAddress" veloce.
# Helius ha un piano gratuito: https://www.helius.dev
RPC_URL=https://mainnet.helius-rpc.com/?api-key=INSERISCI_LA_TUA_API_KEY

# --- Wallet che vuoi copiare (sola lettura, nessuna chiave privata necessaria) ---
TARGET_WALLET=6ePbEvTDFGPembAtY1vwLF4CWbTWKFisUE2G2k53tHHw

# --- Il TUO wallet che esegue i trade ---
# ATTENZIONE: questa e' la chiave privata del wallet che user per operare.
# NON committare mai questo file su GitHub. Tienilo solo su Railway (variabili d'ambiente).
# Formato: array di byte base58 (quello che esporti da Phantom in "Export Private Key")
MY_WALLET_PRIVATE_KEY=

# --- Budget e gestione rischio ---
# Budget totale che il bot puo' usare, in SOL (100 euro ~ vedi conversione al lancio)
TOTAL_BUDGET_SOL=0.6

# Percentuale del budget usata per ogni singolo trade copiato
# ATTENZIONE: 100 = usa TUTTO il budget disponibile ad ogni trade copiato (massimo rischio)
TRADE_SIZE_PERCENT=100

# Slippage massimo accettato (in basis points, 100 = 1%)
SLIPPAGE_BPS=150

# Se true, il bot vende anche quando il wallet copiato vende (copy sell)
COPY_SELL=true

# Liquidita' minima del pool (in USD) sotto la quale il bot NON compra (sicurezza anti-scam)
MIN_LIQUIDITY_USD=20000

# Ogni quanti secondi il bot controlla nuove transazioni del wallet target
POLL_INTERVAL_SECONDS=5

# --- Server di controllo (stato + ON/OFF, usato dalla dashboard) ---
# Chiave segreta per proteggere gli endpoint /api/status e /api/toggle.
# Scegli una stringa lunga e casuale (es. generata con: openssl rand -hex 24)
# e usa la STESSA chiave anche nella dashboard su Vercel.
CONTROL_API_KEY=
